rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/branches/{branchId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Uploads use validated callable functions in the first release.
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
