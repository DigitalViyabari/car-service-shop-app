{
  "expo": {
    "name": "Digital Viyabari Car Service",
    "slug": "digital-viyabari-car-service",
    "version": "0.2.1",
    "orientation": "portrait",
    "scheme": "dvcs",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalviyabari.carserviceshopapp",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.digitalviyabari.carserviceshopapp",
      "versionCode": 3,
      "icon": "./assets/icon.png",
      "googleServicesFile": "./google-services.json",
      "userInterfaceStyle": "light",
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}
