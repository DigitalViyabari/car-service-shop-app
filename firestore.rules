rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function platformSuperAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRoles is list &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRoles.hasAny(["platform_super_admin"]);
    }
    function membership(companyId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + "_" + companyId));
    }
    function companyMember(companyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + "_" + companyId)) &&
        membership(companyId).data.status == "active";
    }
    function companyLevelMember(companyId) {
      return companyMember(companyId) &&
        membership(companyId).data.companyRoles is list &&
        membership(companyId).data.companyRoles.hasAny([
          "company_owner", "company_admin", "company_accountant", "company_auditor"
        ]);
    }
    function companyOwner(companyId) {
      return companyMember(companyId) &&
        membership(companyId).data.companyRoles is list &&
        membership(companyId).data.companyRoles.hasAny(["company_owner", "company_admin"]);
    }
    function companyFinanceViewer(companyId) {
      return companyMember(companyId) && (
        (membership(companyId).data.companyRoles is list &&
         membership(companyId).data.companyRoles.hasAny(["company_owner", "company_admin", "company_accountant"])) ||
        (membership(companyId).data.branchRoleKeys is list &&
         membership(companyId).data.branchRoleKeys.hasAny(["branch_manager", "finance_manager"]))
      );
    }
    function branchMember(companyId, branchId) {
      return companyMember(companyId) &&
        (companyLevelMember(companyId) ||
         (membership(companyId).data.branchIds is list && branchId in membership(companyId).data.branchIds));
    }
    function operationsManager(companyId, branchId) {
      return branchMember(companyId, branchId) &&
        ((membership(companyId).data.companyRoles is list &&
          membership(companyId).data.companyRoles.hasAny(["company_owner", "company_admin"])) ||
         (membership(companyId).data.branchRoleKeys is list &&
          membership(companyId).data.branchRoleKeys.hasAny(["branch_manager"])));
    }
    function jobCreator(companyId, branchId) {
      return branchMember(companyId, branchId) &&
        membership(companyId).data.branchRoleKeys is list &&
        membership(companyId).data.branchRoleKeys.hasAny(["job_creator"]);
    }
    function branchTechnician(companyId, branchId) {
      return companyMember(companyId) &&
        (((membership(companyId).data.branchIds is list &&
          branchId in membership(companyId).data.branchIds) &&
         membership(companyId).data.branchRoleKeys is list &&
          membership(companyId).data.branchRoleKeys.hasAny(["technician"])) ||
         (membership(companyId).data.branchAssignments is list &&
          membership(companyId).data.branchAssignments.hasAny([
            {"branchId": branchId, "roles": ["technician"]}
          ])));
    }
    function customerDataViewer(companyId, branchId) {
      return operationsManager(companyId, branchId) || jobCreator(companyId, branchId);
    }
    function companyCatalogManager(companyId) {
      return companyMember(companyId) && (
        (membership(companyId).data.companyRoles is list &&
         membership(companyId).data.companyRoles.hasAny(["company_owner", "company_admin"])) ||
        (membership(companyId).data.branchRoleKeys is list &&
         membership(companyId).data.branchRoleKeys.hasAny(["branch_manager", "inventory_manager"]))
      );
    }
    function branchFinanceManager(companyId, branchId) {
      return operationsManager(companyId, branchId) ||
        (branchMember(companyId, branchId) && (
        (membership(companyId).data.companyRoles is list &&
         membership(companyId).data.companyRoles.hasAny(["company_accountant"])) ||
        (membership(companyId).data.branchRoleKeys is list &&
         membership(companyId).data.branchRoleKeys.hasAny(["branch_manager", "finance_manager"]))
      ));
    }
    function branchInventoryManager(companyId, branchId) {
      return operationsManager(companyId, branchId) ||
        (branchMember(companyId, branchId) &&
         membership(companyId).data.branchRoleKeys is list &&
         membership(companyId).data.branchRoleKeys.hasAny(["inventory_manager"]));
    }
    function branchProcurementViewer(companyId, branchId) {
      return branchFinanceManager(companyId, branchId) ||
        branchInventoryManager(companyId, branchId);
    }
    function validAuditCreate() {
      return request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }
    function validAuditUpdate() {
      return request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }
    function validManagedJobTransition(jobId) {
      return request.resource.data.status == resource.data.status ||
        (resource.data.status == "check_in" && request.resource.data.status == "inspection") ||
        (resource.data.status == "inspection" && request.resource.data.status == "estimate_pending") ||
        (resource.data.status == "estimate_pending" && request.resource.data.status == "approved" &&
          request.resource.data.approvalStatus == "approved" &&
          request.resource.data.estimateLocked == true) ||
        (resource.data.status == "approved" && request.resource.data.status == "in_progress" &&
          request.resource.data.assignedTechnicianIds is list &&
          request.resource.data.assignedTechnicianIds.size() > 0) ||
        (resource.data.status == "in_progress" && request.resource.data.status == "quality_check") ||
        (resource.data.status == "quality_check" && request.resource.data.status == "ready" &&
          request.resource.data.qualityCheckNotes is string &&
          request.resource.data.qualityCheckNotes.size() >= 3 &&
          request.resource.data.qualityCheckedAt == request.time &&
          request.resource.data.qualityCheckedBy == request.auth.uid) ||
        (resource.data.status == "ready" && request.resource.data.status == "delivered" &&
          exists(/databases/$(database)/documents/invoices/$(jobId))) ||
        (resource.data.status != "delivered" && resource.data.status != "cancelled" &&
          request.resource.data.status == "cancelled" &&
          request.resource.data.cancellationReason is string &&
          request.resource.data.cancellationReason.size() >= 3 &&
          request.resource.data.cancelledAt == request.time &&
          request.resource.data.cancelledBy == request.auth.uid);
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /memberships/{membershipId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /companies/{companyId} {
      allow read: if companyMember(companyId) || platformSuperAdmin();
      allow write: if false;
    }
    match /businessTaxProfiles/{companyId} {
      allow read: if companyFinanceViewer(companyId);
      allow create: if companyOwner(companyId) && request.resource.data.companyId == companyId &&
        request.resource.data.keys().hasAll([
          "companyId", "legalName", "tradeName", "gstRegistered", "registrationType",
          "addressLine1", "city", "state", "stateCode", "postalCode", "invoicePrefix",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && validAuditCreate();
      allow update: if companyOwner(companyId) && resource.data.companyId == companyId &&
        request.resource.data.companyId == resource.data.companyId && validAuditUpdate();
      allow delete: if false;
    }
    match /communicationEntitlements/{companyId} {
      allow read: if platformSuperAdmin() || companyLevelMember(companyId);
      allow create: if platformSuperAdmin() && request.resource.data.companyId == companyId && validAuditCreate();
      allow update: if platformSuperAdmin() && request.resource.data.companyId == resource.data.companyId && validAuditUpdate();
      allow delete: if false;
    }
    match /communicationLedger/{entryId} {
      allow read: if platformSuperAdmin() ||
        (resource.data.companyId is string && companyLevelMember(resource.data.companyId));
      // Ledger entries are written by trusted server processes using the Admin SDK.
      allow write: if false;
    }
    match /communicationCredentials/{credentialId} {
      // Provider credentials are encrypted and accessible only through trusted backend code.
      allow read, write: if false;
    }
    match /branches/{branchId} {
      allow read: if branchMember(resource.data.companyId, branchId);
      allow write: if false;
    }
    match /branchSubscriptions/{branchId} {
      allow get: if signedIn() &&
        exists(/databases/$(database)/documents/branches/$(branchId)) &&
        branchMember(
          get(/databases/$(database)/documents/branches/$(branchId)).data.companyId,
          branchId
        );
      allow list: if resource.data.companyId is string &&
        branchMember(resource.data.companyId, branchId);
      allow write: if false;
    }
    match /customers/{customerId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        customerDataViewer(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "type", "name", "phone", "searchName", "searchPhone",
          "vehicleCount", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) &&
        operationsManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 160 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 15 &&
        request.resource.data.vehicleCount == 0 && request.resource.data.status == "active" && validAuditCreate();
      allow update: if operationsManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.vehicleCount >= 0 && validAuditUpdate();
      allow delete: if false;
    }
    match /vehicles/{vehicleId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        customerDataViewer(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "customerId", "registrationNumber", "searchRegistration",
          "make", "model", "fuelType", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) &&
        operationsManager(request.resource.data.companyId, request.resource.data.branchId) &&
        exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId)) &&
        get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.companyId == request.resource.data.companyId &&
        get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.branchId == request.resource.data.branchId &&
        request.resource.data.registrationNumber is string && request.resource.data.registrationNumber.size() >= 6 && request.resource.data.registrationNumber.size() <= 20 &&
        request.resource.data.make is string && request.resource.data.make.size() >= 1 && request.resource.data.make.size() <= 80 &&
        request.resource.data.model is string && request.resource.data.model.size() >= 1 && request.resource.data.model.size() <= 80 &&
        request.resource.data.status == "active" && validAuditCreate();
      allow update: if operationsManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.customerId == resource.data.customerId && validAuditUpdate();
      allow delete: if false;
    }
    match /vehicleCatalog/{catalogId} {
      allow read: if resource.data.companyId is string && companyMember(resource.data.companyId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "make", "model", "fuelTypes", "transmissions", "searchText",
          "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && companyCatalogManager(request.resource.data.companyId) &&
        request.resource.data.make is string && request.resource.data.make.size() >= 1 && request.resource.data.make.size() <= 80 &&
        request.resource.data.model is string && request.resource.data.model.size() >= 1 && request.resource.data.model.size() <= 80 &&
        request.resource.data.fuelTypes is list && request.resource.data.fuelTypes.size() > 0 &&
        request.resource.data.transmissions is list && request.resource.data.transmissions.size() > 0 &&
        request.resource.data.status == "active" && validAuditCreate();
      allow update: if companyCatalogManager(resource.data.companyId) &&
        request.resource.data.companyId == resource.data.companyId && validAuditUpdate();
      allow delete: if false;
    }
    match /products/{productId} {
      allow read: if resource.data.companyId is string && companyMember(resource.data.companyId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "name", "sku", "type", "gstRate", "unit", "trackInventory",
          "searchText", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && companyCatalogManager(request.resource.data.companyId) &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 160 &&
        request.resource.data.sku is string && request.resource.data.sku.size() >= 1 && request.resource.data.sku.size() <= 64 &&
        request.resource.data.gstRate is number && request.resource.data.gstRate >= 0 && request.resource.data.gstRate <= 100 &&
        request.resource.data.status == "active" && validAuditCreate();
      allow update: if companyCatalogManager(resource.data.companyId) &&
        request.resource.data.companyId == resource.data.companyId && validAuditUpdate();
      allow delete: if false;
    }
    match /inventoryItems/{inventoryId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchMember(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "productId", "purchasePrice", "sellingPrice", "currentStock",
          "reservedStock", "reorderLevel", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchInventoryManager(request.resource.data.companyId, request.resource.data.branchId) &&
        existsAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)) &&
        getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.companyId == request.resource.data.companyId &&
        request.resource.data.purchasePrice >= 0 && request.resource.data.sellingPrice >= 0 &&
        request.resource.data.currentStock >= 0 && request.resource.data.reservedStock >= 0 &&
        request.resource.data.reorderLevel >= 0 && request.resource.data.status == "active" && validAuditCreate();
      allow update: if branchInventoryManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.purchasePrice >= 0 && request.resource.data.sellingPrice >= 0 &&
        request.resource.data.currentStock >= 0 && request.resource.data.reservedStock >= 0 &&
        request.resource.data.reorderLevel >= 0 && validAuditUpdate();
      allow delete: if false;
    }
    match /inventoryMovements/{movementId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchMember(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "productId", "inventoryItemId", "type", "quantity",
          "stockBefore", "stockAfter", "unitCost", "notes", "occurredAt",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchInventoryManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.quantity > 0 && request.resource.data.stockAfter >= 0 &&
        request.resource.data.unitCost >= 0 &&
        exists(/databases/$(database)/documents/inventoryItems/$(request.resource.data.inventoryItemId)) &&
        get(/databases/$(database)/documents/inventoryItems/$(request.resource.data.inventoryItemId)).data.currentStock == request.resource.data.stockBefore &&
        getAfter(/databases/$(database)/documents/inventoryItems/$(request.resource.data.inventoryItemId)).data.currentStock == request.resource.data.stockAfter &&
        request.resource.data.occurredAt == request.time && validAuditCreate();
      allow update, delete: if false;
    }
    match /suppliers/{supplierId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchProcurementViewer(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "name", "phone", "gstin", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchInventoryManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 160 && request.resource.data.status == "active" &&
        validAuditCreate();
      allow update: if branchInventoryManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId && validAuditUpdate();
      allow delete: if false;
    }
    match /purchaseBills/{purchaseId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchProcurementViewer(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "supplierId", "supplierName", "billNumber", "billDate",
          "taxableAmount", "taxAmount", "totalAmount", "paymentStatus", "status",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchInventoryManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.billNumber is string && request.resource.data.billNumber.size() >= 1 &&
        request.resource.data.billNumber.size() <= 80 && request.resource.data.taxableAmount >= 0 &&
        request.resource.data.taxAmount >= 0 && request.resource.data.totalAmount >= 0 &&
        request.resource.data.status == "posted" && validAuditCreate();
      allow update, delete: if false;
    }
    match /purchaseLines/{lineId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchProcurementViewer(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "purchaseId", "productId", "productName", "quantity",
          "unitCost", "gstRate", "taxableAmount", "taxAmount", "totalAmount",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchInventoryManager(request.resource.data.companyId, request.resource.data.branchId) &&
        existsAfter(/databases/$(database)/documents/purchaseBills/$(request.resource.data.purchaseId)) &&
        request.resource.data.quantity > 0 && request.resource.data.unitCost >= 0 &&
        request.resource.data.gstRate >= 0 && request.resource.data.gstRate <= 100 &&
        request.resource.data.totalAmount >= 0 && validAuditCreate();
      allow update, delete: if false;
    }
    match /expenses/{expenseId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchFinanceManager(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "category", "description", "amount", "expenseDate",
          "paymentMethod", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchFinanceManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.description is string && request.resource.data.description.size() >= 2 &&
        request.resource.data.description.size() <= 300 && request.resource.data.amount > 0 &&
        request.resource.data.status == "recorded" && validAuditCreate();
      allow update: if branchFinanceManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId && validAuditUpdate();
      allow delete: if false;
    }
    match /jobSheets/{jobId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        (operationsManager(resource.data.companyId, resource.data.branchId) ||
         jobCreator(resource.data.companyId, resource.data.branchId) ||
         branchFinanceManager(resource.data.companyId, resource.data.branchId) ||
         (branchTechnician(resource.data.companyId, resource.data.branchId) &&
          resource.data.assignedTechnicianIds is list &&
          request.auth.uid in resource.data.assignedTechnicianIds));
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "jobNumber", "customerId", "vehicleId", "status", "priority",
          "serviceType", "odometer", "fuelLevel", "complaints", "checkedInAt",
          "assignedTechnicianIds", "estimateTotal", "invoiceTotal",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && (operationsManager(request.resource.data.companyId, request.resource.data.branchId) ||
          jobCreator(request.resource.data.companyId, request.resource.data.branchId)) &&
        request.resource.data.status == "check_in" &&
        (request.resource.data.odometer == null || request.resource.data.odometer >= 0) &&
        (request.resource.data.fuelLevel == null ||
          (request.resource.data.fuelLevel >= 0 && request.resource.data.fuelLevel <= 100)) &&
        request.resource.data.complaints is list && request.resource.data.complaints.size() > 0 && validAuditCreate();
      allow update: if ((operationsManager(resource.data.companyId, resource.data.branchId) &&
         validManagedJobTransition(jobId)) ||
        (branchTechnician(resource.data.companyId, resource.data.branchId) &&
         resource.data.assignedTechnicianIds is list &&
         request.auth.uid in resource.data.assignedTechnicianIds &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           "status", "deliveredAt", "delayReason", "delayReportedAt", "delayReportedBy",
           "updatedAt", "updatedBy"
         ]) &&
         (((request.resource.data.status == resource.data.status) &&
           request.resource.data.delayReason is string &&
           request.resource.data.delayReason.size() >= 3 &&
           request.resource.data.delayReason.size() <= 500 &&
           request.resource.data.delayReportedAt == request.time &&
           request.resource.data.delayReportedBy == request.auth.uid) ||
          (resource.data.status == "check_in" && request.resource.data.status == "inspection") ||
          (resource.data.status == "inspection" && request.resource.data.status == "estimate_pending") ||
          (resource.data.status == "approved" && request.resource.data.status == "in_progress" &&
           request.resource.data.assignedTechnicianIds is list &&
           request.resource.data.assignedTechnicianIds.size() > 0) ||
          (resource.data.status == "in_progress" && request.resource.data.status == "quality_check")))) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.vehicleId == resource.data.vehicleId &&
        request.resource.data.jobNumber == resource.data.jobNumber && validAuditUpdate();
      allow delete: if false;
    }
    match /jobSequences/{sequenceId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
          (operationsManager(resource.data.companyId, resource.data.branchId) ||
           jobCreator(resource.data.companyId, resource.data.branchId));
      allow create: if request.resource.data.companyId is string &&
        request.resource.data.branchId is string &&
        (operationsManager(request.resource.data.companyId, request.resource.data.branchId) ||
         jobCreator(request.resource.data.companyId, request.resource.data.branchId)) &&
        request.resource.data.lastNumber == 1 && validAuditCreate();
      allow update: if (operationsManager(resource.data.companyId, resource.data.branchId) ||
        jobCreator(resource.data.companyId, resource.data.branchId)) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.financialYear == resource.data.financialYear &&
        request.resource.data.lastNumber == resource.data.lastNumber + 1 && validAuditUpdate();
      allow delete: if false;
    }
    match /serviceReminders/{reminderId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchMember(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "jobId", "customerId", "vehicleId", "registrationNumber",
          "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && operationsManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.status == "scheduled" && validAuditCreate();
      allow update: if operationsManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId && validAuditUpdate();
      allow delete: if false;
    }
    match /serviceTypes/{serviceTypeId} {
      allow read: if resource.data.companyId is string && companyMember(resource.data.companyId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "name", "searchName", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && companyCatalogManager(request.resource.data.companyId) &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 && request.resource.data.status == "active" && validAuditCreate();
      allow update: if companyCatalogManager(resource.data.companyId) &&
        request.resource.data.companyId == resource.data.companyId && validAuditUpdate();
      allow delete: if false;
    }
    match /jobLineItems/{lineId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        (operationsManager(resource.data.companyId, resource.data.branchId) ||
         jobCreator(resource.data.companyId, resource.data.branchId) ||
         branchFinanceManager(resource.data.companyId, resource.data.branchId));
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "jobId", "type", "description", "quantity", "unit",
          "unitPrice", "discount", "gstRate", "taxableAmount", "taxAmount", "totalAmount",
          "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && operationsManager(request.resource.data.companyId, request.resource.data.branchId) &&
        existsAfter(/databases/$(database)/documents/jobSheets/$(request.resource.data.jobId)) &&
        getAfter(/databases/$(database)/documents/jobSheets/$(request.resource.data.jobId)).data.companyId == request.resource.data.companyId &&
        getAfter(/databases/$(database)/documents/jobSheets/$(request.resource.data.jobId)).data.branchId == request.resource.data.branchId &&
        request.resource.data.quantity > 0 && request.resource.data.unitPrice >= 0 &&
        request.resource.data.discount >= 0 && request.resource.data.taxableAmount >= 0 &&
        request.resource.data.taxAmount >= 0 && request.resource.data.totalAmount >= 0 &&
        request.resource.data.status == "active" && validAuditCreate();
      allow update: if operationsManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.jobId == resource.data.jobId && validAuditUpdate();
      allow delete: if false;
    }
    match /invoices/{invoiceId} {
      allow get: if (exists(/databases/$(database)/documents/jobSheets/$(invoiceId)) &&
        branchFinanceManager(
          get(/databases/$(database)/documents/jobSheets/$(invoiceId)).data.companyId,
          get(/databases/$(database)/documents/jobSheets/$(invoiceId)).data.branchId
        )) || (resource.data.companyId is string && resource.data.branchId is string &&
        branchFinanceManager(resource.data.companyId, resource.data.branchId));
      allow list: if resource.data.companyId is string && resource.data.branchId is string &&
        branchFinanceManager(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "jobId", "invoiceNumber", "customerId", "customerName",
          "vehicleId", "vehicleLabel", "registrationNumber", "taxableAmount", "taxAmount",
          "totalAmount", "paidAmount", "balanceAmount", "status", "issuedAt",
          "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchFinanceManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.paidAmount == 0 &&
        request.resource.data.balanceAmount == request.resource.data.totalAmount &&
        request.resource.data.totalAmount >= 0 && request.resource.data.status == "issued" && validAuditCreate();
      allow update: if branchFinanceManager(resource.data.companyId, resource.data.branchId) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.jobId == resource.data.jobId &&
        request.resource.data.invoiceNumber == resource.data.invoiceNumber &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.paidAmount >= resource.data.paidAmount &&
        request.resource.data.balanceAmount == request.resource.data.totalAmount - request.resource.data.paidAmount &&
        validAuditUpdate();
      allow delete: if false;
    }
    match /invoiceLines/{lineId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchFinanceManager(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "invoiceId", "jobLineItemId", "type", "description",
          "quantity", "unit", "unitPrice", "discount", "gstRate", "taxableAmount",
          "taxAmount", "totalAmount", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchFinanceManager(request.resource.data.companyId, request.resource.data.branchId) &&
        existsAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)) &&
        request.resource.data.quantity > 0 && request.resource.data.totalAmount >= 0 && validAuditCreate();
      allow update, delete: if false;
    }
    match /payments/{paymentId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchFinanceManager(resource.data.companyId, resource.data.branchId);
      allow create: if request.resource.data.keys().hasAll([
          "companyId", "branchId", "invoiceId", "jobId", "receiptNumber", "amount", "method",
          "receivedAt", "status", "createdAt", "createdBy", "updatedAt", "updatedBy"
        ]) && branchFinanceManager(request.resource.data.companyId, request.resource.data.branchId) &&
        request.resource.data.amount > 0 && request.resource.data.status == "completed" &&
        existsAfter(/databases/$(database)/documents/invoices/$(request.resource.data.invoiceId)) && validAuditCreate();
      allow update, delete: if false;
    }
    match /{collection}/{documentId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchMember(resource.data.companyId, resource.data.branchId);
      // Operational writes are enabled collection-by-collection as modules are implemented.
      allow create, update, delete: if false;
    }
  }
}
