rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(companyId) {
      return get(/databases/$(database)/documents/memberships/$(request.auth.uid + "_" + companyId));
    }
    function companyMember(companyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + "_" + companyId)) &&
        membership(companyId).data.status == "active";
    }
    function companyLevelMember(companyId) {
      return companyMember(companyId) &&
        membership(companyId).data.companyRoles is list &&
        membership(companyId).data.companyRoles.hasAny([
          "company_owner", "company_admin", "company_accountant", "company_auditor"
        ]);
    }
    function branchMember(companyId, branchId) {
      return companyMember(companyId) &&
        (companyLevelMember(companyId) ||
         (membership(companyId).data.branchIds is list && branchId in membership(companyId).data.branchIds));
    }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /memberships/{membershipId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /companies/{companyId} {
      allow read: if companyMember(companyId);
      allow write: if false;
    }
    match /branches/{branchId} {
      allow read: if branchMember(resource.data.companyId, branchId);
      allow write: if false;
    }
    match /branchSubscriptions/{branchId} {
      allow get: if signedIn() &&
        exists(/databases/$(database)/documents/branches/$(branchId)) &&
        branchMember(
          get(/databases/$(database)/documents/branches/$(branchId)).data.companyId,
          branchId
        );
      allow list: if resource.data.companyId is string &&
        branchMember(resource.data.companyId, branchId);
      allow write: if false;
    }
    match /{collection}/{documentId} {
      allow read: if resource.data.companyId is string && resource.data.branchId is string &&
        branchMember(resource.data.companyId, resource.data.branchId);
      // Operational writes are enabled collection-by-collection as modules are implemented.
      allow create, update, delete: if false;
    }
  }
}
